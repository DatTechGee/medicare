APP_NAME=MediFund
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOURDOMAIN.com/medifund

LOG_CHANNEL=stack

# ---- Database: SQLite (recommended, zero config) ----
DB_CONNECTION=sqlite
DB_DATABASE=

# ---- Or MySQL (Hostinger) ----
# DB_CONNECTION=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=u123456789_medifund
# DB_USERNAME=u123456789_admin
# DB_PASSWORD=your_db_password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_DRIVER=log
MAIL_HOST=
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@YOURDOMAIN.com
MAIL_FROM_NAME="${APP_NAME}"

# ---- MediFund blockchain sync ----
# On shared hosting there is no local Hardhat node: the app runs in
# demo mode automatically. Point MEDIFUND_APP_URL at this deployment.
MEDIFUND_APP_URL=${APP_URL}
MEDIFUND_BENEFICIARY=0x80354450F4c300F178de2Ab718AbA6D2818CE102
MEDIFUND_RECEIVING_WALLET=0x80354450F4c300F178de2Ab718AbA6D2818CE102
MEDIFUND_USD_PER_ETH=3450

SITE_GLOBAL_CURRENCY=USD

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
RAZORPAY_API_KEY=
RAZORPAY_API_SECRET=
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
MOLLIE_KEY=
