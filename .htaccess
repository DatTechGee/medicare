# ============================================================
# MediFund - subfolder deployment entry point
# Clone location example: ~/public_html/medifund/
# All traffic is routed into the Laravel app: @core/public/
# ============================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pass every request into the Laravel public directory
    RewriteRule ^(.*)$ @core/public/$1 [L]
</IfModule>

# Block sensitive files
<FilesMatch "(^\.env|\.env\.|\.sqlite|\.sqlite-journal|\.log$|composer\.|package(-lock)?\.json$|webpack\.mix\.js$|phpunit\.xml$|artisan$)">
    Require all denied
</FilesMatch>

Options -Indexes
